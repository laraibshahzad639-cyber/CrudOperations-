// use prisma-8
enum Role {
  ADMIN
  USER
}
model Task {
  id          String                     @id @onCreate(uuid())
  title       String
  description String?
  completed   Boolean                    @default(false)
  createdAt   TimestamptzString          @default(now())
  updatedAt   temporal.updatedAtString()
}

model User {
  id        String                     @id @onCreate(uuid())
  name      String
  email     String                     @unique
  password  String
   role      Role              @default(USER)
  createdAt TimestamptzString          @default(now())
  updatedAt temporal.updatedAtString()
}
